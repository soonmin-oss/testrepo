import { useMemo, useState } from "react";
import "./CertificationAdvisor.css";

interface Certification {
  id: number;
  name: string;
  provider: string;
  field: string;
  cost: number;
  durationMonths: number;
  description: string;
}

const certifications: Certification[] = [
  {
    id: 1,
    name: "AWS Certified Cloud Practitioner",
    provider: "Amazon Web Services",
    field: "Cloud Computing",
    cost: 100,
    durationMonths: 1,
    description: "Entry-level cloud certification covering AWS basics."
  },
  {
    id: 2,
    name: "Microsoft Azure Fundamentals",
    provider: "Microsoft",
    field: "Cloud Computing",
    cost: 99,
    durationMonths: 1,
    description: "Foundational Azure and cloud concepts."
  },
  {
    id: 3,
    name: "CompTIA Security+",
    provider: "CompTIA",
    field: "Cybersecurity",
    cost: 404,
    durationMonths: 3,
    description: "Industry-standard cybersecurity certification."
  },
  {
    id: 4,
    name: "Google Data Analytics",
    provider: "Google",
    field: "Data Analytics",
    cost: 49,
    durationMonths: 6,
    description: "Learn data analysis and visualization fundamentals."
  },
  {
    id: 5,
    name: "Oracle Java Foundations",
    provider: "Oracle",
    field: "Software Development",
    cost: 245,
    durationMonths: 2,
    description: "Introduces Java programming fundamentals."
  }
];

export default function CertificationAdvisor() {
  const [degree, setDegree] = useState("");
  const [careerGoal, setCareerGoal] = useState("");
  const [maxCost, setMaxCost] = useState(500);
  const [maxDuration, setMaxDuration] = useState(12);

  const [savedCerts, setSavedCerts] = useState<string[]>(() => {
    const stored = localStorage.getItem("savedCertifications");
    return stored ? JSON.parse(stored) : [];
  });

  const recommendations = useMemo(() => {
    return certifications.filter(
      (cert) =>
        cert.cost <= maxCost &&
        cert.durationMonths <= maxDuration
    );
  }, [maxCost, maxDuration]);

  const saveCertification = (name: string) => {
    if (savedCerts.includes(name)) {
      return;
    }

    const updated = [...savedCerts, name];
    setSavedCerts(updated);

    localStorage.setItem(
      "savedCertifications",
      JSON.stringify(updated)
    );
  };

  return (
    <section className="certification-page">
      <header>
        <h1>Certification Advisor</h1>
        <p>
          Discover certifications that align with your education
          and career goals.
        </p>
      </header>

      <div className="certification-form">
        <div className="form-field">
          <label>Degree</label>
          <input
            type="text"
            value={degree}
            placeholder="Computer Science"
            onChange={(e) => setDegree(e.target.value)}
          />
        </div>

        <div className="form-field">
          <label>Career Goal</label>
          <input
            type="text"
            value={careerGoal}
            placeholder="Software Engineer"
            onChange={(e) => setCareerGoal(e.target.value)}
          />
        </div>

        <div className="form-field">
          <label>Maximum Cost ($)</label>
          <input
            type="number"
            value={maxCost}
            onChange={(e) => setMaxCost(Number(e.target.value))}
          />
        </div>

        <div className="form-field">
          <label>Maximum Completion Time (Months)</label>
          <input
            type="number"
            value={maxDuration}
            onChange={(e) => setMaxDuration(Number(e.target.value))}
          />
        </div>
      </div>

      <section className="recommendations">
        <h2>Recommended Certifications</h2>

        {recommendations.length === 0 ? (
          <p>No certifications match your filters.</p>
        ) : (
          recommendations.map((cert) => (
            <div key={cert.id} className="cert-card">
              <h3>{cert.name}</h3>

              <p>
                <strong>Provider:</strong> {cert.provider}
              </p>

              <p>
                <strong>Field:</strong> {cert.field}
              </p>

              <p>
                <strong>Cost:</strong> ${cert.cost}
              </p>

              <p>
                <strong>Duration:</strong> {cert.durationMonths} month(s)
              </p>

              <p>{cert.description}</p>

              <button
                onClick={() => saveCertification(cert.name)}
                disabled={savedCerts.includes(cert.name)}
              >
                {savedCerts.includes(cert.name)
                  ? "Saved"
                  : "Save Goal"}
              </button>
            </div>
          ))
        )}
      </section>

      <section className="saved-certifications">
        <h2>Saved Certification Goals</h2>

        {savedCerts.length === 0 ? (
          <p>No saved certifications.</p>
        ) : (
          <ul>
            {savedCerts.map((cert) => (
              <li key={cert}>{cert}</li>
            ))}
          </ul>
        )}
      </section>
    </section>
  );
}

